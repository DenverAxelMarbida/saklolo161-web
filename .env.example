# Mapbox GL JS needs a public access token to render map tiles.
# Get one free at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token_here

# Backend API base URL (Render).
VITE_API_BASE_URL=https://saklolo161-backend.onrender.com

# Firebase Authentication (Phase 3 web auth cutover) ---------------------
# Firebase Console -> Project Settings -> General -> Your apps (Web app).
# Every Vite env var exposed to the browser MUST be prefixed VITE_ or it
# is silently stripped from the bundle. These identify the public client
# config only — the backend verifies ID tokens with the Admin SDK; no
# service-account material ever belongs in this repo. Supply real values
# via .env.local (gitignored) locally and Vercel environment variables
# in deployment. Never commit real values here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
